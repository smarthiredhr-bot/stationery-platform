datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  OPERATOR
  ADMIN
}

enum OrderType {
  PRINTING
  TYPING_OCR
  CV_BUILDER
  PDF_SERVICE
  LEGAL_DOCUMENT
  DATA_ENTRY
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  PAID
  PROCESSING
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PROCESSING
  SUCCESSFUL
  FAILED
}

model User {
  id            String         @id @default(uuid())
  email         String?        @unique
  phone         String?        @unique
  fullName      String
  role          Role           @default(CUSTOMER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  orders        Order[]
  auditLogs     AuditLog[]
}

model Order {
  id              String         @id @default(uuid())
  orderNumber     String         @unique
  userId          String?
  user            User?          @relation(fields: [userId], references: [id])
  serviceType     OrderType
  status          OrderStatus    @default(PENDING)
  totalAmount     Decimal        @db.Decimal(12, 2)
  currency        String         @default("UGX")
  specifications  Json
  fileAttachments DocumentFile[]
  payment         Payment?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  assignedTo      String?
}

model DocumentFile {
  id             String    @id @default(uuid())
  orderId        String
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  originalName   String
  storageKey     String
  mimeType       String
  pageCount      Int       @default(1)
  isProcessed    Boolean   @default(false)
  uploadedAt     DateTime  @default(now())
}

model PricingMatrix {
  id             String    @id @default(uuid())
  serviceKey     String    @unique
  category       String
  displayName    String
  unitPrice      Decimal   @db.Decimal(12, 2)
  currency       String    @default("UGX")
  isDuplex       Boolean   @default(false)
  paperSize      String?
  updatedAt      DateTime  @updatedAt
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String        @unique
  order             Order         @relation(fields: [orderId], references: [id])
  provider          String
  providerRef       String?       @unique
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("UGX")
  status            PaymentStatus @default(UNPAID)
  customerPhone     String?
  createdAt         DateTime      @default(now())
  verifiedAt        DateTime?
}

model AuditLog {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  timestamp   DateTime  @default(now())
}
